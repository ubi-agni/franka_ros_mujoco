        <material class="panda_robot" name="panda_off_white" rgba="0.901961 0.921569 0.929412 1" />
        <material class="panda_robot" name="panda_black" rgba="0.25 0.25 0.25 1" />
        <material class="panda_robot" name="panda_green" rgba="0 1 0 1" />
        <material class="panda_robot" name="panda_light_blue" rgba="0.39216 0.541176 0.780392 1" />

